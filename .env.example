# One .env for the whole repo. Modules walk up from the working directory to
# find it, so `cd <module> && python3 -m <pkg>` still picks it up from here.

# Jev decision API (required by jev-model-router-module and jev-workflow-module)
JEV_API_KEY=jev_your_key_here
# JEV_BASE_URL=https://www.jevai.org

# Provider keys, only needed for --serve / route_and_serve
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Point a module at a different set of files than the one it ships with
# JEV_MODELS=/path/to/models.json          # jev-model-router-module
# WORKFLOW_MODULES=/path/to/workflows      # jev-workflow-module
# JEV_DATA_POLICY=/path/to/policy.json     # jev-data-policy-module
