# One .env for the whole repo. Modules walk up from the working directory to
# find it, so `cd <module> && python3 -m <pkg>` still picks it up from here.

# Jev decision API (required by jev-model-router-module and jev-workflow-module)
JEV_API_KEY=jev_your_key_here
# JEV_BASE_URL=https://www.jevai.org

# Every JEV_* setting can be answered per module instead, under that module's
# own prefix: the scoped name wins, the shared JEV_ name is the fallback. The
# prefix is the package name without the shared "jev_", so a scoped name never
# reads like one of the JEV_ names every module shares. That is how one module
# is pointed at a different endpoint, key or backend from the root, without
# moving the others with it.
#   MODEL_ROUTER_*   jev-model-router-module/jev_model_router
#   WORKFLOW_*       jev-workflow-module/jev_workflow
#   DATA_POLICY_*    jev-data-policy-module/jev_data_policy
# MODEL_ROUTER_BASE_URL=https://staging.jevai.org   # this module only
# MODEL_ROUTER_API_KEY=jev_...                      # this module only
# WORKFLOW_BASE_URL=https://www.jevai.org

# Which backend answers a Jev decision: native (the Jev API above) or
# openrouter (the Jev model ~typesafe/jev-latest). The standing choice lives in
# ./jev.json, which is checked in and prints itself on every run. These
# variables override that file for one run, per module or for all of them.
# JEV_BACKEND=openrouter
# MODEL_ROUTER_BACKEND=openrouter
# WORKFLOW_BACKEND=native
OPENROUTER_API_KEY=sk-or-v1-...
# JEV_OPENROUTER_MODEL=~typesafe/jev-latest   # pin a Jev version instead of latest

# The OpenRouter key is for Jev decisions only. Serving the model Jev chooses
# goes through that model's own CLI (`claude`, `codex`), which carries its own
# auth — no provider or gateway key reaches a model from here, which is why
# ANTHROPIC_API_KEY and OPENAI_API_KEY are not read by anything.

# Point a module at a different set of files than the one it ships with.
# These resolve exactly like every other setting, so ./jev.json can answer
# them too (under modules.<package>), and the scoped name beats the shared one.
# JEV_MODELS=/path/to/models.json          # or MODEL_ROUTER_MODELS
# JEV_MODULES=/path/to/workflows           # or WORKFLOW_MODULES
# JEV_DATA_POLICY=/path/to/policy.json     # or DATA_POLICY_DATA_POLICY
# JEV_CLI_TIMEOUT=300                      # seconds a model CLI may run
